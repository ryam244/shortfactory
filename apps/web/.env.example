DATABASE_URL=postgresql://shortfactory:shortfactory-local-only@127.0.0.1:5433/shortfactory
# 初回seed時だけ使う。Webサーバーはこの値を読み込まない。
SHORTFACTORY_ADMIN_PASSWORD=
SHORTFACTORY_ADMIN_EMAIL=admin@example.com
SHORTFACTORY_ADMIN_PASSWORD_HASH=
SHORTFACTORY_SESSION_SECRET=replace-with-a-long-random-secret
# ローカルHTTPではSecureを付けず、本番HTTPSではNext.jsが自動で付ける
