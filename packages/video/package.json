    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.527",
    "@remotion/cli": "4.0.527",
    "@remotion/renderer": "4.0.527",
    "@types/node": "^22.20.4",
    "@shortfactory/assets": "workspace:*",
    "@types/react": "^19.3.0",
