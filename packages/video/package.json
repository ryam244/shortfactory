    "evaluation:summary:30": "SHORTFACTORY_EVALUATION_COUNT=30 SHORTFACTORY_OUTPUT_DIR=fixture-30 pnpm exec tsx scripts/summarize-evaluation.ts",
    "evaluation:manifest": "tsx scripts/create-evaluation-manifest.ts",
    "evaluation:technical": "tsx scripts/check-technical-evaluation.ts",
    "evaluation:summary": "tsx scripts/summarize-evaluation.ts",
    "evaluation:review": "tsx scripts/review-evaluation.ts",
    "render:sample": "tsx scripts/render-sample.ts",
    "batch:settings": "tsx scripts/run-batch-settings.ts",
    "evaluation:editorial:5": "tsx scripts/run-editorial-evaluation.ts",
    "worker:render": "tsx scripts/run-render-worker.ts",
    "worker:render:watch": "tsx scripts/run-render-worker.ts --watch",
    "verify:render": "tsx scripts/verify-render-output.ts",
    "cleanup:outputs": "tsx scripts/cleanup-outputs.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo \"no tests yet\""
