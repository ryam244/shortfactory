    "pipeline:test": "tsx scripts/run-local-test.ts",
    "pipeline:fixture:batch": "tsx scripts/run-fixture-batch.ts",
    "evaluation:fixture:30": "SHORTFACTORY_EVALUATION_COUNT=30 SHORTFACTORY_OUTPUT_DIR=fixture-30 pnpm exec tsx scripts/run-fixture-batch.ts",
    "evaluation:manifest:30": "SHORTFACTORY_EVALUATION_COUNT=30 SHORTFACTORY_OUTPUT_DIR=fixture-30 pnpm exec tsx scripts/create-evaluation-manifest.ts",
